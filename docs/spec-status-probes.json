{
  "version": 1,
  "description": "把 docs/SPECIFICATION.md 的状态标注钉在可执行的探针上：每条状态声明都对应一次真实的 parse/validate 调用。任何一侧漂移都会让 crates/verseconf-test/tests/spec_status.rs 失败。",
  "quickref_section": "### 0.4",
  "spec_file": "docs/SPECIFICATION.md",
  "probes": [
    {
      "id": "line-comment",
      "feature": "# 单行注释",
      "section": "### Comments",
      "quickref": "implemented",
      "quickref_key": "单行注释",
      "action": "parse",
      "expect": "ok",
      "source": "# 注释\nkey = 1\n"
    },
    {
      "id": "inline-comment",
      "feature": "行尾注释",
      "section": "### Comments",
      "quickref": "implemented",
      "quickref_key": "行尾注释",
      "action": "parse",
      "expect": "ok",
      "source": "key = \"v\"  # 行尾注释\n"
    },
    {
      "id": "bare-key",
      "feature": "裸键",
      "section": "### Key-Value Pairs",
      "quickref": "implemented",
      "quickref_key": "裸键",
      "action": "parse",
      "expect": "ok",
      "source": "name = \"VerseConf\"\n"
    },
    {
      "id": "double-quoted-string",
      "feature": "双引号字符串",
      "section": "### String Values",
      "quickref": "implemented",
      "quickref_key": "双引号字符串",
      "action": "parse",
      "expect": "ok",
      "source": "s = \"hello\"\n"
    },
    {
      "id": "booleans",
      "feature": "true / false",
      "section": "### Booleans",
      "quickref": "implemented",
      "quickref_key": "true",
      "action": "parse",
      "expect": "ok",
      "source": "a = true\nb = false\n"
    },
    {
      "id": "positive-integer",
      "feature": "正整数",
      "section": "### Numbers",
      "quickref": "implemented",
      "quickref_key": "正整数",
      "action": "parse",
      "expect": "ok",
      "source": "n = 42\n"
    },
    {
      "id": "positive-float",
      "feature": "正浮点数",
      "section": "### Numbers",
      "quickref": "implemented",
      "quickref_key": "正浮点",
      "action": "parse",
      "expect": "ok",
      "source": "f = 3.14\n"
    },
    {
      "id": "date",
      "feature": "日期",
      "section": "### Date and Time",
      "quickref": "implemented",
      "quickref_key": "日期",
      "action": "parse",
      "expect": "ok",
      "source": "d = 2024-06-01\n"
    },
    {
      "id": "timestamp",
      "feature": "时间戳",
      "section": "### Date and Time",
      "quickref": "implemented",
      "quickref_key": "时间戳",
      "action": "parse",
      "expect": "ok",
      "source": "t = 2024-01-15T09:00:00Z\n"
    },
    {
      "id": "duration-seconds",
      "feature": "时长 30s",
      "section": "### Date and Time",
      "quickref": "implemented",
      "quickref_key": "时长",
      "action": "parse",
      "expect": "ok",
      "source": "d = 30s\n"
    },
    {
      "id": "array",
      "feature": "数组",
      "section": "### Arrays",
      "quickref": "implemented",
      "quickref_key": "数组",
      "action": "parse",
      "expect": "ok",
      "source": "a = [1, 2, 3]\n"
    },
    {
      "id": "block-table",
      "feature": "块表",
      "section": "### Tables (Blocks)",
      "quickref": "implemented",
      "quickref_key": "块表",
      "action": "parse",
      "expect": "ok",
      "source": "tbl {\n  k = 1\n}\n"
    },
    {
      "id": "array-table",
      "feature": "表数组",
      "section": "### Tables (Blocks)",
      "quickref": "implemented",
      "quickref_key": "表数组",
      "action": "parse",
      "expect": "ok",
      "source": "[[srv]]\nname = \"a\"\n"
    },
    {
      "id": "inline-table",
      "feature": "内联表",
      "section": "### Tables (Blocks)",
      "quickref": "implemented",
      "quickref_key": "内联表",
      "action": "parse",
      "expect": "ok",
      "source": "t = { a = 1 }\n"
    },
    {
      "id": "quoted-expression",
      "feature": "引号内表达式",
      "section": "### Expressions",
      "quickref": "implemented",
      "quickref_key": "引号内",
      "action": "parse",
      "expect": "ok",
      "source": "port = 80\nurl = \"${port}\"\n"
    },
    {
      "id": "env-default-pipe",
      "feature": "引号内 ${ENV:VAR} 默认值",
      "section": "### Expressions",
      "quickref": "implemented",
      "quickref_key": "引号内",
      "action": "parse",
      "expect": "ok",
      "source": "h = \"${ENV:HOST|127.0.0.1}\"\n"
    },
    {
      "id": "include-directive",
      "feature": "@include 指令",
      "section": "### File Inclusion",
      "quickref": "implemented",
      "quickref_key": "@include",
      "action": "parse_no_include",
      "expect": "ok",
      "source": "@include \"x.vcf\"\n"
    },
    {
      "id": "include-merge",
      "feature": "@include merge=",
      "section": "### File Inclusion",
      "quickref": "implemented",
      "quickref_key": "merge=",
      "action": "parse_no_include",
      "expect": "ok",
      "source": "@include \"x.vcf\" merge=deep_merge\n"
    },
    {
      "id": "crlf",
      "feature": "CRLF 行尾",
      "section": "### Encoding",
      "quickref": "implemented",
      "quickref_key": "CRLF",
      "action": "parse",
      "expect": "ok",
      "source": "k = 1\r\nj = 2\r\n"
    },
    {
      "id": "schema-range-ok",
      "feature": "schema range 校验通过",
      "section": "### Schema Field Attributes",
      "quickref": "implemented",
      "quickref_key": "range",
      "action": "validate",
      "expect": "ok",
      "source": "#@schema {\n  version = \"1.0\"\n  port { type = \"integer\" required = true range = 1024..65535 }\n}\nport = 8080\n"
    },
    {
      "id": "schema-required-ok",
      "feature": "schema required 校验通过",
      "section": "### Schema Field Attributes",
      "quickref": "implemented",
      "quickref_key": "required",
      "action": "validate",
      "expect": "ok",
      "source": "#@schema {\n  version = \"1.0\"\n  port { type = \"integer\" required = true range = 1024..65535 }\n}\nport = 8080\n"
    },
    {
      "id": "schema-enum-ok",
      "feature": "schema enum 校验通过",
      "section": "### Schema Field Attributes",
      "quickref": "implemented",
      "quickref_key": "enum",
      "action": "validate",
      "expect": "ok",
      "source": "#@schema {\n  version = \"1.0\"\n  mode { type = \"string\" enum = [\"dev\", \"prod\"] }\n}\nmode = \"dev\"\n"
    },
    {
      "id": "validate-strict-rejects",
      "feature": "validate --strict 拒绝未声明字段",
      "section": "### Strict Mode",
      "quickref": "implemented",
      "quickref_key": "validate --strict",
      "action": "validate_strict",
      "expect": "error",
      "source": "#@schema {\n  version = \"1.0\"\n  port { type = \"integer\" }\n}\nport = 8080\nundeclared = 1\n"
    },
    {
      "id": "block-comment",
      "feature": "### 块注释",
      "section": "### Comments",
      "quickref": "unimplemented",
      "quickref_key": "块注释",
      "action": "parse",
      "expect": "error",
      "source": "###\nblock comment\n###\nk = 1\n"
    },
    {
      "id": "quoted-key",
      "feature": "带引号的键",
      "section": "### Key-Value Pairs",
      "quickref": "unimplemented",
      "quickref_key": "带引号的键",
      "action": "parse",
      "expect": "error",
      "source": "\"server.host\" = \"localhost\"\n"
    },
    {
      "id": "triple-quoted",
      "feature": "三引号字符串",
