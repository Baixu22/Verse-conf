      "feature": "r\"...\" 原始字符串",
      "section": "### String Values",
      "quickref": "unimplemented",
      "quickref_key": "原始字符串",
      "action": "parse",
      "expect": "error",
      "source": "p = r\"C:\\\\tmp\\\\x.txt\"\n"
    },
    {
      "id": "negative-number",
      "feature": "负数字面量",
      "section": "### Numbers",
      "quickref": "unimplemented",
      "quickref_key": "负数字面量",
      "action": "parse",
      "expect": "error",
      "source": "n = -42\n"
